# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings → API Keys).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Só no servidor. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# URL de fallback para desenvolvimento e convites.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Duas publicações do mesmo código: admin ou customer. Vazio libera ambas localmente.
APP_SURFACE=
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
NEXT_PUBLIC_MENU_URL=http://localhost:3000

# Domínio próprio (fase 2): registra domínios no projeto público pela API da Vercel.
# Token de conta criado em Account Settings → Tokens (escopo do time). Sem ele, as
# telas mostram as instruções de DNS mas não registram nem verificam o domínio.
VERCEL_TOKEN=
VERCEL_PROJECT_ID_MENU=prj_fblGqEvBa78sBgAcVjnzzkoBKoBO
VERCEL_TEAM_ID=team_rtfVwbf1pzgX89eOofZsWCbc

# Somente para scripts/prepare-partner-demo.ts; nunca publicar na Vercel.
DEMO_USER_PASSWORD=

# Senha das contas de demonstração criadas por `npm run db:seed-users`.
SEED_USER_PASSWORD=

# Opcional: senha própria da conta de revenda já existente, usada pelos testes.
SEED_RESELLER_PASSWORD=
